# ---------------------------------------------------------------
# NuraHome Care — contoh environment variable
# JANGAN commit berkas .env yang sudah berisi nilainya.
# ---------------------------------------------------------------

DATABASE_URL=postgresql://pengguna:sandi@host:5432/nurahome

# Menjaga endpoint /api/cron. TANPA ini, endpointnya menolak SEMUA
# permintaan — bukan berjalan tanpa penjagaan. Minimal 16 karakter.
#   openssl rand -base64 32
CRON_SECRET=

# Garam untuk sidik jari alamat IP di pembatasan laju masuk.
# Tanpa garam, sidik jari IP bisa dibalik dengan mencoba keempat miliar
# alamat IPv4 — jumlah yang habis dihitung dalam hitungan menit.
#   openssl rand -base64 32
IP_HASH_SALT=

# Kunci enkripsi cadangan basis data. Skrip cadangan BERHENTI tanpa ini —
# tidak pernah menyimpan versi polos. Minimal 16 karakter.
# SIMPAN DI LUAR SERVER juga: kalau kuncinya hilang, cadangannya hilang.
#   openssl rand -base64 32
BACKUP_PASSPHRASE=
BACKUP_DIR=/var/backups/nurahome
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# Kata sandi awal untuk akun contoh saat basis data pertama kali diisi.
# DI PRODUKSI, kalau dikosongkan, akun contoh dibuat TANPA kata sandi dan
# tidak bisa dipakai masuk sama sekali. Itu disengaja — kata sandi bawaan
# yang tertulis di dalam kode adalah cara paling lazim aplikasi jatuh.
SEED_PASSWORD=

# ---------------------------------------------------------------
# Pembayaran (Midtrans) — lihat PEMBAYARAN.md
# ---------------------------------------------------------------

# RAHASIA. Dipakai untuk memanggil API Midtrans DAN untuk memeriksa
# tanda tangan kabar yang masuk. Tidak pernah boleh sampai ke browser.
MIDTRANS_SERVER_KEY=

# Boleh terbuka — memang dirancang untuk dipakai di browser.
MIDTRANS_CLIENT_KEY=

# SANDBOX | PRODUKSI
# Kunci sandbox (berawalan SB-) pada mode PRODUKSI DITOLAK aplikasi.
# Tanpa penjagaan itu, aplikasinya berjalan mulus, pasien "membayar",
# dan tidak satu rupiah pun benar-benar berpindah.
MIDTRANS_MODE=SANDBOX

# ---------------------------------------------------------------
# Asisten tanya-jawab — model AI (OPSIONAL)
# ---------------------------------------------------------------
#
# KOSONGKAN SAJA KALAU BELUM YAKIN. Tanpa ini asisten tetap bekerja
# penuh: tanda bahaya, pemilihan layanan, pertanyaan lanjutan, dan
# perapi catatan perawat semuanya berjalan dengan pencocokan kata.
#
# Yang BERUBAH kalau ini dipasang: asisten jadi memahami kalimat yang
# tidak memakai kata-kata di daftar, jawabannya terasa lebih luwes, dan
# ia bisa menaikkan tanda bahaya yang daftar kata tidak kenali.
#
# Yang TIDAK berubah, apa pun isinya:
#   - keputusan tanda bahaya tetap dipegang daftar kata di server;
#     model hanya boleh MENAMBAH, tidak pernah mencabut;
#   - isi rekam medis tidak pernah dikirim ke penyedia mana pun;
#   - nama layanan dan tarif selalu dibaca dari tabel layanan.
#
# SEBELUM DIPASANG, PUTUSKAN DULU (ini bukan keputusan teknis):
# kalimat keluhan pasien akan terkirim ke server penyedia, umumnya di
# luar negeri. Keluhan kesehatan adalah data pribadi spesifik menurut
# UU 27/2022 Pasal 4 ayat (2). Yang dikirim sudah disaring — tanpa
# nama, nomor telepon, surel, kode pesanan, maupun foto — tetapi
# keluhannya sendiri memang keluar. Siapkan perjanjian pemrosesan data
# dengan penyedianya, dan sebutkan ini di kebijakan privasi Anda.

# GEMINI | OPENAI | ANTHROPIC
# AI_PENYEDIA=GEMINI

# AI_API_KEY=

# Opsional. Kalau kosong, dipakai model termurah & tercepat tiap penyedia:
#   GEMINI    → gemini-2.5-flash   (punya kuota gratis)
#   OPENAI    → gpt-4o-mini
#   ANTHROPIC → claude-haiku-4-5
# AI_MODEL=

# ---------------------------------------------------------------
# Hanya untuk TES — jangan dipasang di server sungguhan
# ---------------------------------------------------------------

# Mengalihkan panggilan API Midtrans ke penyedia tiruan di localhost,
# supaya jalur pembayaran bisa diuji tanpa menyentuh Midtrans.
# DIABAIKAN di mode PRODUKSI, apa pun isinya (lihat src/server/midtrans.ts).
# MIDTRANS_API_BASE=http://127.0.0.1:3211

# Mengalihkan panggilan model ke penyedia tiruan di localhost, supaya
# jalur AI bisa diuji tanpa menyentuh penyedia sungguhan dan tanpa biaya.
# AI_API_BASE=http://127.0.0.1:3212
